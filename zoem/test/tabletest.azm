\docsec{list}{The roff list form}

\par{In the man page this table is a list; elsewhere a table.}

\begin{table}{{spec}{{l}{lx}{lx}}{roff}{list}}
\thead{{Reason (as reported)}{Typical cause}{Operators that give NA}}
\trow{
   {unmapped (FLAG 0x4, RNAME or CIGAR '*')}
   {unmapped reads in aligner output}
   {all position, count, CIGAR-part, sequence-part, alignment and rbt
    operators}}
\trow{
   {reference length not known}
   {SAM without header and without \v{--sam/FILE}}
