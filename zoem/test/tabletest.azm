\docsec{align}{Alignment, no rules}

\par{Left, centre and right; rowsep none; a | in prose.}

\begin{table}{{spec}{{l}{c}{r}}{rowsep}{none}}
\thead{{Operator}{Arity}{Count}}
\trow{{\v{add}}{2}{1024}}
\trow{{\v{len}}{1}{7}}
\trow{{a | b}{1}{12}}
