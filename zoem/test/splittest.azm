   {tocnum}{0}
}

\plukdoc{pluk-splittest}{Split test}

\par{Before the first section. Forward references: \sref{two} and \sref{three},
   both on the second page.}

\docsec{one}{First section}

\par{On the first page; \sref{one} is this one.}

\page{splittest-2}{Second and third}

\docsec{two}{Second section}

\par{On the second page; back to \sref{one} on the first page, and on to
   \sref{three} on this page.}

