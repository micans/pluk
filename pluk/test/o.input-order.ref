== -kU 3 1 3 2
a	b	c
== -KU 3 1 3 2
1	2	3
a	b	c
== -kU 2-3 1
a	b	c
== -kU 3 x::1^a,cat 1
a	c	aa
== -kU 3:1:2
a	b	c
== -U fib name x::^1 sq
name	fib	sq	x
Ann	1	1	1
== -U -i fib name fib::fib^1,add y::^2
name	fib	y
Ann	2	2
== -UA name x::^1
name	fib	fib2	sq	fx	ud	ms	num1	num2	num4	foo11	abc	dna	x
Ann	1	0	1	dog	1	0.142857	1	2	1	a_n_n	a	ACGTTGCA	1
== -Ux fib x::^1
name	fib2	sq	fx	ud	ms	num1	num2	num4	foo11	abc	dna	x
Ann	0	1	dog	1	0.142857	1	2	1	a_n_n	a	ACGTTGCA	1
== -U dna +n.*
name	num1	num2	num4	dna
Ann	1	2	1	ACGTTGCA
== dna name fib name
-- Identical output column names exist (will make unique)
dna	name	fib
ACGTTGCA	Ann	1
