use std::io::{self, Read};
Is functionally the same as:

use std::io;
use std::io::Read;

--

use std::env;

fn main() {
    let args: Vec<String> = env::args().collect();

    let arg = match args.get(2) {
        Some(val) => val,
        None => {
            println!("Not enough arguments provided!");
            return;
        }
    };

    let min_no_of_bytes = match arg.parse::<u64>() {
        Ok(val) => val,
        Err(e) => {
            println!("Unable to parse number from argument: {}", e);
            return;
        }
    };

    let no_of_times_to_repeat = min_no_of_bytes as usize;
    let inputtext = '0'.to_string().repeat(no_of_times_to_repeat);

    println!("{}", inputtext);
}

--

https://docs.rs/clap/latest/clap/

cargo add clap --features derive

use clap::Parser;

/// Simple program to greet a person
#[derive(Parser, Debug)]
#[command(version, about, long_about = None)]
struct Args {
    /// Name of the person to greet
    #[arg(short, long)]
    name: String,

    /// Number of times to greet
    #[arg(short, long, default_value_t = 1)]
    count: u8,
}

fn main() {
    let args = Args::parse();

    for _ in 0..args.count {
        println!("Hello {}!", args.name);
    }
}

--

When you use the src/bin/ directory structure, Cargo automatically recognizes every .rs file in that folder as a separate binary. You don't need to add anything to your Cargo.toml.

If you have a file at src/bin/test.rs, you can compile or run it using these commands:

1. To Run

Bash
cargo run --bin test
2. To Build (Compile)

This compiles the binary and places it in target/debug/test:

Bash
cargo build --bin test
3. To Build for Release

This applies optimizations and places the final binary in target/release/test:

Bash
cargo build --release --bin test
Key Rules for the src/bin/ Folder:

Filename as Identity: The name of the file (e.g., test.rs) becomes the name of the command (test).

No Configuration: You can delete the [[bin]] sections from your Cargo.toml if you move the files into src/bin/, as Cargo handles the discovery automatically.

Subdirectories: If you want a binary to have its own module files, you can create a folder like src/bin/my_tool/main.rs. Cargo will then treat my_tool as the binary name.

